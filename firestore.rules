rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // every user can read and write only their own planner
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // events shared between Google accounts, by email
    match /shared/{eventId} {
      function signedIn() {
        return request.auth != null && request.auth.token.email_verified == true;
      }
      function me() {
        return request.auth.token.email.lower();
      }

      // you can see an event only if your email is on it
      allow read: if signedIn() && me() in resource.data.participants;

      // only the creator can create, and must be on the list
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && me() in request.resource.data.participants
        && request.resource.data.participants.size() <= 21;

      allow update: if signedIn() && (
        // the creator can edit everything
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && me() in request.resource.data.participants
          && request.resource.data.participants.size() <= 21)
        ||
        // a guest can only remove themselves
        (me() in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
          && request.resource.data.participants == resource.data.participants.removeAll([me()]))
      );

      // only the creator can delete
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
